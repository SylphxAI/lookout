#!/usr/bin/env node
/**
 * Zero-config Lookout launcher for npm/npx.
 * Resolves package root from this file's real path (works with npm bin shims).
 * Default (no args): MCP stdio server — `npx -y @sylphx/lookout`.
 * CLI: `lookout help|doctor|search|...` or `lookout mcp`.
 */
import { spawn, execFileSync } from 'node:child_process';
import { existsSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const here = dirname(fileURLToPath(import.meta.url));
const root = join(here, '..');
const cliTs = join(root, 'src', 'cli.ts');
const mcpTs = join(root, 'src', 'mcp.ts');

function hasBun() {
  try {
    execFileSync('bun', ['--version'], { stdio: 'ignore' });
    return true;
  } catch {
    return false;
  }
}

function execEntry(entry, args) {
  if (!existsSync(entry)) {
    console.error(`lookout: missing entry ${entry}`);
    process.exit(1);
  }
  if (hasBun()) {
    const child = spawn('bun', [entry, ...args], { stdio: 'inherit' });
    child.on('exit', (code, signal) => {
      if (signal) process.kill(process.pid, signal);
      process.exit(code ?? 1);
    });
    return;
  }
  const major = Number(process.versions.node.split('.')[0]);
  if (Number.isNaN(major) || major < 22) {
    console.error('lookout requires Node.js >= 22 (or bun) for zero-config npx');
    process.exit(1);
  }
  const child = spawn(process.execPath, ['--experimental-strip-types', entry, ...args], {
    stdio: 'inherit',
  });
  child.on('exit', (code, signal) => {
    if (signal) process.kill(process.pid, signal);
    process.exit(code ?? 1);
  });
}

const argv = process.argv.slice(2);
if (argv.length === 0) {
  execEntry(mcpTs, []);
} else {
  execEntry(cliTs, argv);
}
