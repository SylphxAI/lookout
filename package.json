{
  "name": "@sylphx/lookout",
  "version": "0.1.2",
  "private": false,
  "description": "Lookout — local-first web instrument for agents. Search, fetch, extract, cache with citeable excerpts. No required API key. SDK · CLI · MCP.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lookout": "./bin/lookout"
  },
  "exports": {
    ".": "./src/sdk.ts",
    "./sdk": "./src/sdk.ts",
    "./engine": "./src/engine.ts"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "docs",
    "server.json",
    "src"
  ],
  "scripts": {
    "test": "bun test",
    "start": "bun src/cli.ts",
    "mcp": "bun src/mcp.ts",
    "doctor": "./bin/lookout doctor",
    "benchmark:release-gate": "bun scripts/release-gate.ts",
    "validate": "bun test && bun scripts/release-gate.ts",
    "benchmark:public-proof": "bun scripts/public-proof.ts",
    "brand:pack-plan": "bun scripts/brand-pack-plan.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylphxAI/lookout.git"
  },
  "homepage": "https://github.com/SylphxAI/lookout#readme",
  "mcpName": "io.github.SylphxAI/lookout",
  "keywords": [
    "mcp",
    "local-first",
    "web-search",
    "lookout",
    "sylphx",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  }
}
