{
  "name": "@sylphx/lookout",
  "version": "0.3.1",
  "private": false,
  "description": "Lookout — web research with source-level proof. Local-first search, fetch, extract, cache, and citeable excerpts.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lookout": "./bin/lookout"
  },
  "exports": {
    ".": "./src/sdk.ts",
    "./sdk": "./src/sdk.ts",
    "./engine": "./src/engine.ts"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "docs",
    "server.json",
    "src"
  ],
  "scripts": {
    "test": "bun test",
    "start": "bun src/cli.ts",
    "mcp": "bun src/mcp.ts",
    "doctor": "bun src/cli.ts doctor",
    "benchmark:release-gate": "bun scripts/release-gate.ts",
    "validate": "bun test && bun scripts/release-gate.ts",
    "benchmark:public-proof": "bun scripts/public-proof.ts",
    "brand:pack-plan": "bun scripts/brand-pack-plan.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylphxAI/lookout.git"
  },
  "homepage": "https://sylphxai.github.io/lookout/",
  "mcpName": "io.github.SylphxAI/lookout",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-search",
    "web-research",
    "web-scraping",
    "fetch",
    "extract",
    "html",
    "crawl",
    "cache",
    "citations",
    "source-excerpts",
    "search",
    "research",
    "ssrf-safe",
    "local-first",
    "ai-agents",
    "developer-tools",
    "lookout",
    "sylphx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  }
}
